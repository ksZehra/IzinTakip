{
  "name": "izintakip-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api-tipleri": "npx --yes openapi-typescript@7.13.0 http://127.0.0.1:5137/openapi/v1.json -o src/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "axios": "1.21.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vuetify": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.5",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "3.3.13"
  }
}
